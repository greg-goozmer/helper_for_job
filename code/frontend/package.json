{
  "name": "interview-assistant-checkpoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interview Assistant — подготовка к собеседованиям",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node ../scripts/serve.mjs",
    "start": "node ../scripts/serve.mjs",
    "check": "node --check src/app.js && node --check src/model.js && node --check src/data.js && node --check ../scripts/serve.mjs",
    "test": "node --test ../tests/*.test.mjs",
    "check:docs": "node ../scripts/check-docs.mjs"
  }
}
